diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,8 @@
 cmake_minimum_required(VERSION 3.10)
+
+# apple_support's cc toolchain puts a literal STRIP_DEBUG_SYMBOLS in its link flags for wrapped_clang, which rules_foreign_cc passes through
+# without the matching LINKED_BINARY= arg, so wrapped_clang ends up running `strip ""`
+set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/cmake/BazelRulesOverride.cmake")
 
 # Must be done first
 if (APPLE)
diff --git a/cmake/BazelRulesOverride.cmake b/cmake/BazelRulesOverride.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/BazelRulesOverride.cmake
@@ -0,0 +1,3 @@
+foreach (kind EXE SHARED MODULE)
+    string(REPLACE "STRIP_DEBUG_SYMBOLS" "" CMAKE_${kind}_LINKER_FLAGS_INIT "${CMAKE_${kind}_LINKER_FLAGS_INIT}")
+endforeach ()
diff --git a/cmake/Modules/ValkeySetup.cmake b/cmake/Modules/ValkeySetup.cmake
--- a/cmake/Modules/ValkeySetup.cmake
+++ b/cmake/Modules/ValkeySetup.cmake
@@ -139,6 +139,8 @@
         set(MALLOC_LIB "jemalloc")
         set(ALLOCATOR_LIB "jemalloc")
         add_valkey_server_compiler_options("-DUSE_JEMALLOC")
+        # BCR jemalloc is the same upstream 5.3.0 as deps/jemalloc, minus the header marker that gates active defrag
+        add_valkey_server_compiler_options("-DVALKEY_VENDORED_JEMALLOC=1")
         set(USE_JEMALLOC 1)
     elseif ("${BUILD_MALLOC}" STREQUAL "libc")
         set(MALLOC_LIB "libc")
@@ -287,7 +289,7 @@
 
 # Update linker flags for the allocator
 if (USE_JEMALLOC)
-    include_directories("${CMAKE_SOURCE_DIR}/deps/jemalloc/include")
+    include_directories("${JEMALLOC_INCLUDE_DIR}")
 endif ()
 
 # Common compiler flags
@@ -344,11 +346,9 @@
     add_custom_target(generate_test_files_h)
 endif ()
 
-# Generate release.h file (always)
-add_custom_target(
-    release_header
-    COMMAND sh -c '${CMAKE_SOURCE_DIR}/src/mkreleasehdr.sh'
-    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}/src")
+# src/release.h is checked in by this patch; mkreleasehdr.sh always rewrites it in the sandbox, since outside a git repo
+# `git diff -- ../src ../deps` silently falls back to --no-index and diffs the two directories against each other
+add_custom_target(release_header)
 
 # -------------------------------------------------
 # Code Generation section - end
