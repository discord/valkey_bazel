"""Builds Valkey from source with Bazel, one repository per release."""

module(
    name = "valkey_bazel",
    version = "0.1.0",
    bazel_compatibility = [">=7.4.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "jemalloc", version = "5.3.0-bcr.4")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
